[package]
name = "keystore-ocsp"
version.workspace = true
edition.workspace = true
license.workspace = true
repository.workspace = true
homepage.workspace = true
readme = "../../README.md"
keywords.workspace = true
categories.workspace = true
description = "OCSP request, response, responder and verification for RFC 6960"

[lints]
workspace = true

[dependencies]
keystore-core.workspace = true
keystore-pki.workspace = true
x509-cert = { version = "0.2.5", features = ["builder", "pem", "std"] }
der = { version = "0.7", features = ["alloc", "derive", "oid", "pem", "std"] }
spki = { version = "0.7", features = ["alloc", "std"] }
rasn = "0.29"
rasn-ocsp = "0.29"
signature = { version = "2", features = ["std"] }
sha1 = "0.10"
sha2 = "0.10"
thiserror.workspace = true
rand.workspace = true
hex.workspace = true
