{
  "/api/apps/{aid}/tokens": {
    "get": {
      "parameters": [
        {
          "in": "path",
          "name": "aid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/TokenDetails"
                },
                "type": "array"
              }
            }
          },
          "description": "Tokens"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Service tokens for an app",
      "description": "Requires workspace membership and secrets:read. Lists metadata, never token plaintext.",
      "tags": [
        "tokens"
      ]
    },
    "post": {
      "parameters": [
        {
          "in": "path",
          "name": "aid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/TokenIssueRequest"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenIssued"
              }
            }
          },
          "description": "Token (shown once)"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Create a service token",
      "description": "Requires tokens:create. Machine and environment-scoped tokens cannot mint service tokens. A supplied env_id must belong to this app. The token is shown once.",
      "tags": [
        "tokens"
      ]
    }
  },
  "/api/tokens/{tid}": {
    "delete": {
      "parameters": [
        {
          "in": "path",
          "name": "tid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRevoked"
              }
            }
          },
          "description": "Revoked"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not found"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Revoke a service token",
      "description": "Only the token creator or a workspace member with the literal owner or admin role may revoke it.",
      "tags": [
        "tokens"
      ]
    }
  }
}
