{
  "/api/envs/{eid}/path-policy/{role}": {
    "delete": {
      "description": "Deletes the role's path policy. Environment owner required.",
      "parameters": [
        {
          "in": "path",
          "name": "eid",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "path",
          "name": "role",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          },
          "description": "Deleted"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Delete a role path policy",
      "tags": [
        "path-policy"
      ]
    },
    "get": {
      "description": "Returns the stored path policy for the role, or null when none is set. Environment owner required.",
      "parameters": [
        {
          "in": "path",
          "name": "eid",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "path",
          "name": "role",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PathPolicy"
              }
            }
          },
          "description": "Policy or null"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Read a role path policy",
      "tags": [
        "path-policy"
      ]
    },
    "put": {
      "description": "Replaces the policy rules for the role. Requires an explicit SSE environment; role cannot be owner; at most 256 rules. Body is a rules array.",
      "parameters": [
        {
          "in": "path",
          "name": "eid",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "path",
          "name": "role",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/PathPolicy"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          },
          "description": "Saved"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Rules array required, role invalid, or environment not SSE"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Replace a role path policy",
      "tags": [
        "path-policy"
      ]
    }
  }
}
