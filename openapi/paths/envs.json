  "/api/apps/{aid}/envs": {
    "get": {
      "description": "Requires organisation membership. Environment-scoped tokens cannot use this application route. ",
      "parameters": [
        {
          "in": "path",
          "name": "aid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/EnvironmentDetails"
                },
                "type": "array"
              }
            }
          },
          "description": "Success"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request or database error"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Authentication required"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Permission, environment access, lockdown or credential scope denied"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "List application environments",
      "tags": [
        "envs"
      ]
    },
    "post": {
