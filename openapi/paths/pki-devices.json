  "/api/pki/renew": {
    "post": {
      "description": "Request challenge_id and padded base64 detached signature of the exact returned challenge text. P256 ECDSA SHA256 or P384 ECDSA SHA384 ASN.1 DER, Ed25519, or RSA PKCS1 SHA256. Optional attestation JWT or tpm_evidence follows the current CA policy, with nonce equal to challenge_id. Replacement issuance and previous-certificate revocation commit atomically.",
      "parameters": [],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "description": "Success"
        },
        "400": {
          "description": "Invalid request"
        },
        "403": {
          "description": "Policy or authorization denied"
        },
        "409": {
          "description": "State changed; retry"
        }
      },
      "security": [],
      "summary": "Renew with a detached proof signed by the active certificate key",
      "tags": [
        "PKI"
      ]
    }
  },
  "/api/pki/renew/challenge": {
    "post": {
      "description": "Request device_id and new PEM CSR. Returns challenge_id, exact challenge text and expires_at. A proof must use the existing active certificate key, not the CSR key.",
      "parameters": [],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object"
            }
