  "/api/pki/devices/{did}/tpm": {
    "get": {
      "parameters": [
        {
          "in": "path",
          "name": "did",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Success"
        },
        "400": {
          "description": "Invalid request"
        },
        "403": {
          "description": "Policy or authorization denied"
        },
        "409": {
          "description": "State changed; retry"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Read the trusted TPM AK and PCR policy",
      "tags": [
        "PKI"
      ]
    },
    "put": {
      "parameters": [
        {
          "in": "path",
          "name": "did",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "ak_public": {
                  "description": "Padded base64 exact TPM2B_PUBLIC, provisioned out of band",
                  "type": "string"
                },
                "pcr_digest": {
                  "description": "SHA256 of concatenated SHA256 PCR values 0 through 7",
                  "pattern": "^[0-9A-Fa-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "ak_public",
                "pcr_digest"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "description": "Success"
        },
        "400": {
          "description": "Invalid request"
        },
        "403": {
          "description": "Policy or authorization denied"
        },
        "409": {
          "description": "State changed; retry"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Provision a trusted TPM AK public area and PCR policy",
      "tags": [
        "PKI"
      ]
    }
  },
