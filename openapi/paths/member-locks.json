{
  "/api/orgs/{oid}/members/{target}/lock": {
    "post": {
      "description": "Locks a member out of the workspace while keeping their membership. Owner-only; owners themselves cannot be locked (change the member's role first). Audited as member.lock; the response carries the audited confirmation.",
      "parameters": [
        {
          "in": "path",
          "name": "oid",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "path",
          "name": "target",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          },
          "description": "Member locked"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Only an owner can lock members"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Member not found"
        },
        "409": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Workspace owners cannot be locked"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Lock a member out of the workspace (owner only)",
      "tags": [
        "members"
      ]
    }
  },
  "/api/orgs/{oid}/members/{target}/unlock": {
    "post": {
      "description": "Removes a member's lock so they can authenticate again. Owner-only; audited as member.unlock.",
      "parameters": [
        {
          "in": "path",
          "name": "oid",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "path",
          "name": "target",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          },
          "description": "Member unlocked"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Only an owner can unlock members"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Member not found"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Unlock a member (owner only)",
      "tags": [
        "members"
      ]
    }
  }
}
