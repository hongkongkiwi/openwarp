{
 "/api/orgs/{oid}/transit/keys":{
  "get":{"summary":"List transit keys","description":"Requires org:admin and transit:manage. Environment credentials are forbidden. OAuth and service credentials require the explicit transit:manage scope, even when otherwise privileged.","tags":["transit"],"parameters":[{"in":"path","name":"oid","required":true,"schema":{"type":"string"}}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Key metadata","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/TransitKey"}}}}},"400":{"description":"Storage error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Insufficient transit authority or workspace halted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},
  "post":{"summary":"Create a transit key","description":"Requires org:admin and transit:manage with explicit scope for OAuth/service credentials. Environment credentials are forbidden. Creates version 1; raw keys never leave the server.","tags":["transit"],"parameters":[{"in":"path","name":"oid","required":true,"schema":{"type":"string"}}],"security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["name"],"properties":{"name":{"type":"string","pattern":"^[A-Za-z0-9_.-]{1,128}$"}}}}}},"responses":{"200":{"description":"Key metadata","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TransitKey"}}}},"400":{"description":"Invalid name or storage error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Insufficient authority or workspace halted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Lifecycle conflict, including duplicate key creation","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"501":{"description":"Atomic mutation unavailable on Workers","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}
 },
 "/api/orgs/{oid}/transit/keys/{kid}/rotate":{"post":{"summary":"Rotate a transit key","description":"Requires org:admin and transit:manage with explicit OAuth/service scope; environment credentials are forbidden. Increments current_version and retains prior versions for decryption.","tags":["transit"],"parameters":[{"in":"path","name":"oid","required":true,"schema":{"type":"string"}},{"in":"path","name":"kid","required":true,"schema":{"type":"string"}}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Current version","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TransitVersion"}}}},"400":{"description":"Storage error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Insufficient authority, workspace halted or key unavailable in workspace","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Lifecycle changed; retry","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"501":{"description":"Atomic mutation unavailable on Workers","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},
 "/api/orgs/{oid}/transit/keys/{kid}/{action}":{"post":{"summary":"Encrypt, decrypt or rewrap transit data","description":"Requires the corresponding transit:encrypt, transit:decrypt or transit:rewrap permission and explicit OAuth/service scope. Environment credentials are forbidden. Context is required and bound to ciphertext (maximum 1024 bytes). Encrypt accepts base64 plaintext up to 1 MiB. Decrypt and rewrap accept canonical owt1 ciphertext up to 2000000 bytes, bound to this workspace/key/context. Rewrap returns latest-version ciphertext without returning plaintext.","tags":["transit"],"parameters":[{"in":"path","name":"oid","required":true,"schema":{"type":"string"}},{"in":"path","name":"kid","required":true,"schema":{"type":"string"}},{"in":"path","name":"action","required":true,"schema":{"type":"string","enum":["encrypt","decrypt","rewrap"]}}],"security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TransitOperation"}}}},"responses":{"200":{"description":"Plaintext for decrypt; ciphertext for encrypt or rewrap","content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/TransitPlaintext"},{"$ref":"#/components/schemas/TransitCiphertext"}]}}}},"400":{"description":"Invalid action, input, ciphertext or context","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Insufficient authority, workspace halted or key unavailable","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Key lifecycle changed; retry","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}}
}
