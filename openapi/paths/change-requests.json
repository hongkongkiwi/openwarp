{
  "/api/orgs/{oid}/change-requests": {
    "get": {
      "summary": "List visible change requests",
      "description": "Requires workspace membership. Requests whose entire encrypted payload cannot be opened through the caller's environment scope/access are omitted.",
      "tags": [
        "change-requests"
      ],
      "parameters": [
        {
          "in": "path",
          "name": "oid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "Visible requests",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ChangeRequest"
                }
              }
            }
          }
        },
        "400": {
          "description": "Storage failure",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "401": {
          "description": "Invalid credential",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "403": {
          "description": "Not a workspace member or workspace halted",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        }
      }
    },
    "post": {
      "summary": "Create a multi-environment change request",
      "description": "Requires proposals:write and access to each target. Only SSE targets in this workspace are supported; all targets must be running. Maximum 20 environments and 500 operations. Sealed secrets cannot change type without deletion/recreation. Snapshot is saved atomically.",
      "tags": [
        "change-requests"
      ],
      "parameters": [
        {
          "in": "path",
          "name": "oid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ChangeRequestInput"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Pending revision 1",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeRequestResult"
              }
            }
          }
        },
        "400": {
          "description": "Invalid snapshot or storage failure",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "401": {
          "description": "Invalid credential",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "403": {
          "description": "Permission, scope, tenancy or lockdown denial",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "404": {
          "description": "Environment not found",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "409": {
          "description": "Conflicting target or unsupported environment mode",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "501": {
          "description": "Atomic change requests unavailable on Workers",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        }
      }
    }
  },
  "/api/change-requests/{id}": {
    "get": {
      "summary": "Read a change request and reviewed changes",
      "description": "Requires secrets:read and scope/access to every running SSE target. The value fields within before and after objects are null when either side is sealed; a missing before or deleted after is itself null.",
      "tags": [
        "change-requests"
      ],
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "Request and redacted diff",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeRequestDetail"
              }
            }
          }
        },
        "400": {
          "description": "Storage or key failure",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "401": {
          "description": "Invalid credential",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "403": {
          "description": "Permission, scope or lockdown denial",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "404": {
          "description": "Request or environment not found",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "409": {
          "description": "Snapshot cannot be opened or mode no longer SSE",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        }
      }
    },
    "put": {
      "summary": "Replace a change request snapshot",
      "description": "Only the author with proposals:write can edit pending or approved requests. Current revision is required. Must still access all old targets and new running SSE targets. Increments revision and clears approval atomically.",
      "tags": [
        "change-requests"
      ],
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ChangeRequestInput"
                },
                {
                  "required": [
                    "revision"
                  ]
                }
              ]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "New pending revision",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeRequestResult"
              }
            }
          }
        },
        "400": {
          "description": "Invalid snapshot or missing revision",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "401": {
          "description": "Invalid credential",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "403": {
          "description": "Not author, insufficient access or lockdown",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "404": {
          "description": "Request or environment not found",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "409": {
          "description": "Revision, state or snapshot conflict",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "501": {
          "description": "Atomic change requests unavailable on Workers",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        }
      }
    }
  },
  "/api/change-requests/{id}/{action}": {
    "post": {
      "summary": "Approve, apply or reject a change request",
      "description": "Requires org:admin, exact current revision and access to every running SSE target. Authors cannot approve or apply. Approve requires pending and secrets:read; apply requires approved and secrets:write/secrets:delete per operation; reject permits pending or approved. Apply atomically checks the original rows and retention policy. Provider sync follows local commit and errors are reported per environment.",
      "tags": [
        "change-requests"
      ],
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "path",
          "name": "action",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "approve",
              "apply",
              "reject"
            ]
          }
        }
      ],
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "revision"
              ],
              "properties": {
                "revision": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Action result and sync errors",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeRequestResult"
              }
            }
          }
        },
        "400": {
          "description": "Missing revision or invalid action",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "401": {
          "description": "Invalid credential",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "403": {
          "description": "Author or permission/access/lockdown denial",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "404": {
          "description": "Request or environment not found",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "409": {
          "description": "Revision, state, key, target or policy changed",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "501": {
          "description": "Atomic change requests unavailable on Workers",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        }
      }
    }
  }
}
