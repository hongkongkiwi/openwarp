{
 "/api/orgs/{oid}/ssh/cas":{
  "get":{"summary":"List SSH CAs","description":"Requires workspace membership. Returns public keys, fingerprints and forwarding policy, not private keys.","tags":["ssh"],"parameters":[{"in":"path","name":"oid","required":true,"schema":{"type":"string"}}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"SSH CAs","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/SshCa"}}}}},"400":{"description":"Storage failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Not a workspace member","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},
  "post":{"summary":"Create an SSH CA","description":"Requires org:admin. Creates an Ed25519 CA, with forwarding disabled by default. No certificate can be issued until role principal grants are configured.","tags":["ssh"],"parameters":[{"in":"path","name":"oid","required":true,"schema":{"type":"string"}}],"security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string","default":"ssh-ca"},"allow_forwarding":{"type":"boolean","default":false}}}}}},"responses":{"200":{"description":"CA public key and sshd instructions","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SshCaCreated"}}}},"400":{"description":"Generation or storage failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Not an administrator","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}
 },
 "/api/ssh/cas/{caid}":{"get":{"summary":"Read SSH CA configuration","description":"Requires org:admin. Returns public key, forwarding policy, sshd instructions and role grants.","tags":["ssh"],"parameters":[{"in":"path","name":"caid","required":true,"schema":{"type":"string"}}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"CA configuration","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SshCaDetail"}}}},"400":{"description":"Storage failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Not an administrator","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"SSH CA not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},
 "/api/ssh/cas/{caid}/grants":{"put":{"summary":"Replace all SSH role principal grants","description":"Requires org:admin. Nonempty list replaces all grants; omitted roles lose access. Roles must exist and cannot repeat. Patterns are exact names, a single trailing * prefix or bare *. Only an owner may grant bare *. max_ttl defaults to 900 and is clamped to 60-28800 seconds.","tags":["ssh"],"parameters":[{"in":"path","name":"caid","required":true,"schema":{"type":"string"}}],"security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SshGrantsRequest"}}}},"responses":{"200":{"description":"Granted roles","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SshGrantsUpdated"}}}},"400":{"description":"Invalid role/pattern, empty grants, duplicate role or storage failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Not an administrator or non-owner wildcard grant","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"SSH CA not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},
 "/api/ssh/cas/{caid}/sign":{"post":{"summary":"Sign an SSH user certificate","description":"Requires workspace membership and a matching principal grant for the caller's role. Subject private keys never reach the server. Root or any principal under a bare * grant requires a real account and a single-use very_risky step-up grant (email plus TOTP if enabled); machine identities are forbidden for those principals. User TTL defaults to 900, bounded by grant maximum and 28800 seconds. Certificate validity is backdated 60 seconds.","tags":["ssh"],"parameters":[{"in":"path","name":"caid","required":true,"schema":{"type":"string"}},{"in":"header","name":"X-OpenWarp-Step-Up","required":false,"schema":{"type":"string"},"description":"Single-use very_risky grant required for privileged principals."}],"security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SshSignRequest"}}}},"responses":{"200":{"description":"Signed certificate and parsed verification fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SshSigned"}}}},"400":{"description":"Invalid principal/key, signing or storage failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Principal not granted or privileged machine request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"SSH CA not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"428":{"description":"Step-up verification required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SshStepUpRequired"}}}},"503":{"description":"Privileged issuance requires an email provider","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},
 "/api/ssh/cas/{caid}/certs":{"get":{"summary":"List issued SSH certificates","description":"Requires org:admin. Lists the latest 200 user and host certificate metadata records, newest first.","tags":["ssh"],"parameters":[{"in":"path","name":"caid","required":true,"schema":{"type":"string"}}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Certificate metadata","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/SshCertificate"}}}}},"400":{"description":"Storage failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Not an administrator","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"SSH CA not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},
 "/api/ssh/cas/{caid}/revoked-keys":{"get":{"summary":"Download the SSH RevokedKeys text file","description":"Requires org:admin. One revoked OpenSSH certificate per line; hosts must refresh their local file to enforce revocation.","tags":["ssh"],"parameters":[{"in":"path","name":"caid","required":true,"schema":{"type":"string"}}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"RevokedKeys file","content":{"text/plain":{"schema":{"type":"string"}}}},"400":{"description":"Storage failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Not an administrator","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"SSH CA not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},
 "/api/ssh/cas/{caid}/krl":{"get":{"summary":"Download the OpenSSH KRL","description":"Requires org:admin. Binary serial-based revocation list for this CA, attached as openwarp.krl. Hosts must refresh it to enforce revocation.","tags":["ssh"],"parameters":[{"in":"path","name":"caid","required":true,"schema":{"type":"string"}}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"OpenSSH KRL bytes","content":{"application/octet-stream":{"schema":{"type":"string","format":"binary"}}}},"400":{"description":"Invalid CA public key or storage failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Not an administrator","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"SSH CA not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},
 "/api/ssh/cas/{caid}/hosts":{
  "get":{"summary":"List registered SSH hosts","description":"Requires org:admin. Returns hostname and fingerprint metadata ordered by hostname, not the stored public key.","tags":["ssh"],"parameters":[{"in":"path","name":"caid","required":true,"schema":{"type":"string"}}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Host registrations","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/SshHost"}}}}},"400":{"description":"Storage failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Not an administrator","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"SSH CA not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},
  "post":{"summary":"Register a hostname and SSH public key","description":"Requires org:admin. Hostnames are literal DNS-style labels without wildcards. Re-registering an identical hostname and key fingerprint returns the existing id with existing:true.","tags":["ssh"],"parameters":[{"in":"path","name":"caid","required":true,"schema":{"type":"string"}}],"security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SshHostRequest"}}}},"responses":{"200":{"description":"Registration","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SshHostRegistered"}}}},"400":{"description":"Invalid hostname/key or storage failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Not an administrator","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"SSH CA not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}
 },
 "/api/ssh/cas/{caid}/hosts/{hid}":{"delete":{"summary":"Delete an SSH host registration","description":"Requires org:admin. Outstanding certificates remain valid until expiry or separately enforced revocation.","tags":["ssh"],"parameters":[{"in":"path","name":"caid","required":true,"schema":{"type":"string"}},{"in":"path","name":"hid","required":true,"schema":{"type":"string"}}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Deleted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Deleted"}}}},"400":{"description":"Storage failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Not an administrator","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"SSH CA or host not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},
 "/api/ssh/cas/{caid}/sign-host":{"post":{"summary":"Sign an SSH host certificate","description":"Requires workspace membership and an exact registered hostname/key fingerprint pair. Default TTL is 30 days, clamped to 60 seconds through 90 days. No user principal grant or step-up is used. Certificate validity is backdated 60 seconds.","tags":["ssh"],"parameters":[{"in":"path","name":"caid","required":true,"schema":{"type":"string"}}],"security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SshHostRequest"}}}},"responses":{"200":{"description":"Signed host certificate inside JSON","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SshSigned"}}}},"400":{"description":"Invalid hostname/key, signing or storage failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Not a member or hostname/key is not registered","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"SSH CA not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},
 "/api/ssh/certs/{cid}/revoke":{"post":{"summary":"Revoke an SSH certificate","description":"Requires org:admin. Marks the certificate revoked; hosts must refresh their RevokedKeys or KRL to enforce it.","tags":["ssh"],"parameters":[{"in":"path","name":"cid","required":true,"schema":{"type":"string"}}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Revoked","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SshRevoked"}}}},"400":{"description":"Storage failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Not an administrator","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Certificate or SSH CA not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}}
