  "/api/orgs/{oid}/webhooks": {
    "get": {
      "description": "Requires an organisation-admin credential (unscoped, or an OAuth/token principal carrying org:admin). Returns at most 100 subscriptions newest first.",
      "parameters": [
        {
          "in": "path",
          "name": "oid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/WebhookSubscription"
                },
                "type": "array"
              }
            }
          },
          "description": "Subscriptions"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Database error"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not an organisation admin or credential is environment-scoped"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "List outgoing webhook subscriptions",
      "tags": [
        "webhooks"
      ]
    },
    "post": {
      "description": "Creates a subscription and returns its signing secret once as whsec_<base64>. The URL must be HTTPS outside private networks unless OPENWARP_ALLOW_PRIVATE_EGRESS=1. Optional app_id scopes deliveries to one application; events defaults to [\"*\"] and accepts audit action names or *. asymmetric=true adds an Ed25519 signature whose public key is returned as whpk_. A workspace holds at most 100 subscriptions.",
      "parameters": [
        {
          "in": "path",
          "name": "oid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "app_id": {
                  "type": "string"
                },
                "asymmetric": {
                  "type": "boolean"
                },
                "enabled": {
                  "type": "boolean"
                },
                "events": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "name": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "url"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookSubscriptionCreated"
              }
            }
          },
          "description": "Subscription with one-time signing secret"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid URL, name or event filters"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not an organisation admin"
        },
        "409": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Subscription limit reached"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Create an outgoing webhook subscription",
      "tags": [
        "webhooks"
      ]
    }
  },
