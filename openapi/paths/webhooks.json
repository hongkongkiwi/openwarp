      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/WebhookReceipt"
                },
                "type": "array"
              }
            }
          },
          "description": "Receipt rows"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Webhook not found"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "List incoming receipts",
      "tags": [
        "webhooks"
      ]
    }
  },
  "/api/incoming-webhooks/{wid}/receipts/{rid}": {
    "get": {
      "description": "One receipt's metadata plus its captured payload, decrypted on the fly. A payload erased by master-key rotation returns body_available=false with a null body.",
