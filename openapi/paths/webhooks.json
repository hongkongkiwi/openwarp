  "/api/incoming-webhooks/{wid}/receipts": {
    "get": {
      "description": "Receipt metadata only: status, attempts, outcome and safe error codes. Captured payloads are never included.",
      "parameters": [
        {
          "in": "path",
          "name": "wid",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "query",
          "name": "limit",
          "schema": {
            "default": 25,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          }
        },
        {
          "in": "query",
          "name": "offset",
          "schema": {
            "default": 0,
            "maximum": 100000,
            "minimum": 0,
            "type": "integer"
          }
