{
  "/api/envs/{eid}/dynamic": {
    "get": { "summary": "List active dynamic leases", "description": "Requires environment access and secrets:read. Returns decrypted values for unrevoked, unexpired leases only.", "tags": ["leases"], "parameters": [{"in":"path","name":"eid","required":true,"schema":{"type":"string"}}], "security":[{"bearerAuth":[]}], "responses": {"200":{"description":"Active leases","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/LeaseActive"}}}}},"400":{"description":"Storage or key error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Access denied","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Environment not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}} },
    "post": { "summary":"Issue a dynamic lease", "description":"Requires environment access and leases:write. ttl_secs defaults to 3600 and is clamped to 60-2592000. Database types require config.connection and allowed DB hosts; mysql also requires 1-8 config.grants. planetscale requires config.service_token, organization, database and branch (optional config.service_token_id for id:token tokens) and accepts engine mysql or postgres; instabox requires config.api_key and machine_id. Supports postgres, mysql, aws_iam, planetscale, instabox and provider child keys; other types create generic random tokens. Failed remote issuance may retain a pending reservation requiring operator reconciliation.", "tags":["leases"],"parameters":[{"in":"path","name":"eid","required":true,"schema":{"type":"string"}}],"security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LeaseCreate"}}}},"responses":{"200":{"description":"Issued credentials; shape depends on type","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LeaseIssued"}}}},"400":{"description":"Invalid config or provider failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Access denied","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Environment not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Issuance persistence or cleanup failed; reconcile pending lease","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}} }
  },
  "/api/leases/{lid}": {
    "get":{"summary":"Read lease metadata","description":"Requires matching token environment scope, environment access and secrets:read. Does not return the secret value; includes expired and revoked leases.","tags":["leases"],"parameters":[{"in":"path","name":"lid","required":true,"schema":{"type":"string"}}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Metadata","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LeaseMetadata"}}}},"400":{"description":"Storage failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Access denied","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Lease or environment not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},
    "delete":{"summary":"Revoke a lease","description":"Requires environment access and leases:write. Remote revocation must succeed before the local lease is marked revoked. Pending unresolved issuance returns 409.","tags":["leases"],"parameters":[{"in":"path","name":"lid","required":true,"schema":{"type":"string"}}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Revoked","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LeaseRevoked"}}}},"400":{"description":"Storage, decryption or remote revocation failed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Access denied","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Lease or environment not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Unresolved issuance requires reconciliation","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}
  },
  "/api/leases/{lid}/renew":{"post":{"summary":"Extend local lease expiry","description":"Requires environment access and leases:write. Rejects revoked leases, but does not check whether expiry has passed. Updates only local expires_at, not the remote credential lifetime. ttl_secs defaults to 3600 and is clamped to 60-2592000.","tags":["leases"],"parameters":[{"in":"path","name":"lid","required":true,"schema":{"type":"string"}}],"security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LeaseRenew"}}}},"responses":{"200":{"description":"New expiry","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LeaseRenewed"}}}},"400":{"description":"Revoked lease or storage failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Access denied","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Lease or environment not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}}
