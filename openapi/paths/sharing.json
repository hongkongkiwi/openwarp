  "/api/proposals/{pid}/{action}": {
    "post": {
      "description": "Requires access to the proposal environment and org:admin permission. Only pending proposals can be decided; action must be approve or reject. Approval applies secrets and returns per-integration sync errors. The handler does not compare caller to author, so admin authors can decide their own proposal. Environment-scoped tokens cannot use this route.",
