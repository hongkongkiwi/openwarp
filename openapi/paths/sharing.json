{
  "/api/access-requests/{rid}/{action}": {
    "post": {
      "description": "Requires environment access and org:admin permission. approve adds an environment member; every other action string rejects. Already-decided requests return 400. Environment-scoped tokens cannot use this route.",
      "parameters": [
        {
          "in": "path",
          "name": "rid",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "path",
          "name": "action",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccessDecision"
              }
            }
          },
          "description": "Success"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request or database error"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Authentication required"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Permission, environment access, lockdown or credential scope denied"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not found"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Decide a pending environment access request",
      "tags": [
        "sharing"
      ]
    }
  },
