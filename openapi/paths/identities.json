{
  "/api/orgs/{oid}/identities": {
    "get": {
      "parameters": [
        {
          "in": "path",
          "name": "oid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/IdentityDetails"
                },
                "type": "array"
              }
            }
          },
          "description": "Identities"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Machine identities",
      "tags": [
        "identities"
      ],
      "description": "Requires org:admin. Lists identity metadata and nullable client_id, never client secrets."
    },
    "post": {
      "parameters": [
        {
          "in": "path",
          "name": "oid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/IdentityCreate"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdentityCreated"
              }
            }
          },
          "description": "Credentials (secret shown once)"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Create a machine identity",
      "description": "Requires org:admin. Role defaults to developer; owner is forbidden and custom roles must exist. Only an owner can create an identity with admin-equivalent permissions.",
      "tags": [
        "identities"
      ]
    }
  },
  "/api/orgs/{oid}/identities/{iid}": {
    "delete": {
      "parameters": [
        {
          "in": "path",
          "name": "oid",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "path",
          "name": "iid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Deleted"
              }
            }
          },
          "description": "Deleted"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not found"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Delete a machine identity",
      "tags": [
        "identities"
      ],
      "description": "Requires org:admin and an identity belonging to this workspace. Deletes its credentials and all tokens issued for the identity."
    }
  },
  "/api/orgs/{oid}/identities/{iid}/rotate": {
    "post": {
      "parameters": [
        {
          "in": "path",
          "name": "oid",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "path",
          "name": "iid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdentityCreated"
              }
            }
          },
          "description": "New credentials"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not found"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Rotate a machine identity secret",
      "tags": [
        "identities"
      ],
      "description": "Requires org:admin and an identity belonging to this workspace. Replaces the client secret, preserving client_id when present. Existing access tokens are not revoked; the new secret is shown once."
    }
  },
  "/api/orgs/{oid}/identities/{iid}/workload-trust": {
    "get": {
      "summary": "List workload trusts for an identity",
      "description": "Requires org:admin in a running workspace. The identity must belong to this workspace; only an owner may configure privileged identities. Returns metadata including revoked trusts, without JWKS or bound claims.",
      "tags": [
        "identities"
      ],
      "parameters": [
        {
          "in": "path",
          "name": "oid",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "path",
          "name": "iid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "Trust metadata",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/WorkloadTrust"
                }
              }
            }
          }
        },
        "400": {
          "description": "Storage failure",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "401": {
          "description": "Invalid credential",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "403": {
          "description": "Permission, identity ownership or lockdown denial",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        }
      }
    },
    "post": {
      "summary": "Create an inline workload trust",
      "description": "Requires org:admin in a running workspace; only an owner may configure privileged identities. The single environment must belong to this workspace and be accessible within the caller's scope. Exact issuer, audience, subject and optional bound claims are pinned to inline public JWKS; no keys are fetched remotely. Only explicit secrets:read/secrets:write scopes are supported.",
      "tags": [
        "identities"
      ],
      "parameters": [
        {
          "in": "path",
          "name": "oid",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "path",
          "name": "iid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/WorkloadTrustCreate"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Trust id, environment and TTL",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkloadTrustCreated"
              }
            }
          }
        },
        "400": {
          "description": "Invalid claims, scopes, TTL, JWKS or storage failure",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "401": {
          "description": "Invalid credential",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "403": {
          "description": "Permission, tenancy, scope or lockdown denial",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "404": {
          "description": "Environment not found",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        }
      }
    }
  },
  "/api/orgs/{oid}/identities/{iid}/workload-trust/{tid}": {
    "delete": {
      "summary": "Revoke a workload trust and its tokens",
      "description": "Requires org:admin in a running workspace; only an owner may configure privileged identities. Marks the trust revoked and deletes issued tokens. Live policy denies existing tokens even if token cleanup fails.",
      "tags": [
        "identities"
      ],
      "parameters": [
        {
          "in": "path",
          "name": "oid",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "path",
          "name": "iid",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "path",
          "name": "tid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "Revoked trust id",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkloadTrustRevoked"
              }
            }
          }
        },
        "400": {
          "description": "Storage or cleanup failure",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "401": {
          "description": "Invalid credential",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "403": {
          "description": "Permission, identity ownership or lockdown denial",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "404": {
          "description": "Trust not found for this identity and workspace",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        }
      }
    }
  },
  "/api/v1/machine/auth/universal/login": {
    "post": {
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MachineLoginRequest"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MachineLogin"
              }
            }
          },
          "description": "Access token"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        }
      },
      "summary": "Exchange client credentials for a one-hour token",
      "tags": [
        "machine"
      ],
      "parameters": [],
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "description": "Authenticates with client_id and client_secret, not a bearer credential. Requires a running identity workspace. Returns a one-hour access token; machine tokens cannot mint service tokens."
    }
  }
}
