{
  "/api/envs/{eid}/integrations": {
    "get": {
      "parameters": [
        {
          "in": "path",
          "name": "eid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/Integration"
                },
                "type": "array"
              }
            }
          },
          "description": "Integrations"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        },
        "404": {
          "description": "Environment or application not found",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Integrations for an environment",
      "tags": [
        "integrations"
      ],
      "description": "Requires environment access and secrets:read. Lists metadata without provider configuration or credentials."
    },
    "post": {
      "parameters": [
        {
          "in": "path",
          "name": "eid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "type": "string"
                },
                "name": {
                  "type": "string",
                  "description": "Defaults to kind."
                },
                "config": {
                  "default": {},
                  "description": "Provider configuration, sealed to the runner for delegated environments."
                }
              }
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Id"
              }
            }
          },
          "description": "Created"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        },
        "404": {
          "description": "Environment or application not found",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Create an integration",
      "tags": [
        "integrations"
      ],
      "description": "Requires environment access and integrations:write. Supported provider kind is required; config defaults to an empty object. Delegated configurations are sealed to the customer runner."
    }
  },
  "/api/integrations/{iid}": {
    "delete": {
      "parameters": [
        {
          "in": "path",
          "name": "iid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Deleted"
              }
            }
          },
          "description": "Deleted"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        },
        "404": {
          "description": "Environment or application not found",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Delete an integration",
      "tags": [
        "integrations"
      ],
      "description": "Requires environment access and integrations:write. Removes local configuration, sync state and queued jobs; does not delete remote provider secrets."
    },
    "patch": {
      "parameters": [
        {
          "in": "path",
          "name": "iid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/IntegrationUpdate"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Ok"
              }
            }
          },
          "description": "Updated"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        },
        "404": {
          "description": "Environment or application not found",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Update an integration",
      "tags": [
        "integrations"
      ],
      "description": "Requires environment access and integrations:write. Only supplied kind, name and config fields change. Delegated configurations are sealed to the customer runner."
    }
  },
  "/api/integrations/{iid}/sync": {
    "post": {
      "parameters": [
        {
          "in": "path",
          "name": "iid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncResult"
              }
            }
          },
          "description": "Sync report"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        },
        "404": {
          "description": "Environment or application not found",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Push the environment to the integration",
      "tags": [
        "integrations"
      ],
      "description": "Requires environment access and integrations:write. Pushes non-sealed environment values; delegated mode queues work for the customer runner. Provider failures return an error, not a successful sync report."
    }
  },
  "/api/integrations/{iid}/test": {
    "post": {
      "parameters": [
        {
          "in": "path",
          "name": "iid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncResult"
              }
            }
          },
          "description": "Connection report"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        },
        "501": {
          "description": "Connection test not implemented for this provider kind",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        },
        "404": {
          "description": "Environment or application not found",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          }
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Test the integration credentials",
      "tags": [
        "integrations"
      ],
      "description": "Requires environment access and integrations:write. Delegated mode queues a connection test. Native provider tests run only for supported kinds; other kinds return 501."
    }
  }
}
