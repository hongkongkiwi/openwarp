{
  "/api/envs/{eid}/integrations": {
    "get": {
      "description": "Requires environment access and secrets:read. Lists metadata without provider configuration or credentials.",
      "parameters": [
        {
          "in": "path",
          "name": "eid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/Integration"
                },
                "type": "array"
              }
            }
          },
          "description": "Integrations"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Environment or application not found"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Integrations for an environment",
      "tags": [
        "integrations"
      ]
    },
    "post": {
      "description": "Requires environment access and integrations:write. Supported provider kind is required; config defaults to an empty object. Delegated configurations are sealed to the customer runner.",
      "parameters": [
        {
          "in": "path",
          "name": "eid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "config": {
                  "default": {},
                  "description": "Provider configuration, sealed to the runner for delegated environments."
                },
                "kind": {
                  "type": "string"
                },
                "name": {
                  "description": "Defaults to kind.",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Id"
              }
            }
          },
          "description": "Created"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Environment or application not found"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Create an integration",
      "tags": [
        "integrations"
      ]
    }
  },
