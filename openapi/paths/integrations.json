          "in": "path",
          "name": "iid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Deleted"
              }
            }
          },
          "description": "Deleted"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Environment or application not found"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Delete an integration",
      "tags": [
        "integrations"
      ]
    },
    "patch": {
      "description": "Requires environment access and integrations:write. Only supplied kind, name and config fields change. Delegated configurations are sealed to the customer runner.",
      "parameters": [
        {
          "in": "path",
          "name": "iid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/IntegrationUpdate"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Ok"
              }
            }
          },
          "description": "Updated"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Environment or application not found"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Update an integration",
      "tags": [
        "integrations"
      ]
    }
  },
  "/api/integrations/{iid}/history": {
    "get": {
      "description": "Latest 50 sync and sync-failure audit rows for the integration, newest first. Requires secrets:read on the integration's environment.",
      "parameters": [
        {
          "in": "path",
          "name": "iid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/IntegrationHistoryEntry"
                },
                "type": "array"
              }
            }
          },
          "description": "Sync history rows"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Integration not found"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "List integration sync history",
      "tags": [
        "integrations"
      ]
    }
  },
  "/api/integrations/{iid}/sync": {
    "post": {
      "description": "Requires environment access and integrations:write. Pushes non-sealed environment values; delegated mode queues work for the customer runner. Provider failures return an error, not a successful sync report.",
      "parameters": [
        {
          "in": "path",
          "name": "iid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncResult"
              }
            }
          },
          "description": "Sync report"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Environment or application not found"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Push the environment to the integration",
      "tags": [
        "integrations"
      ]
    }
  },
  "/api/integrations/{iid}/test": {
    "post": {
      "description": "Requires environment access and integrations:write. Delegated mode queues a connection test. Providers with a bespoke test verify their API. For other known kinds the native server sends an unauthenticated GET without following redirects; any HTTP response, including 401 or 403, counts as reachable, not credential verification. URL userinfo is rejected. Workers return HTTP 400 without sending a generic probe.",
      "parameters": [
        {
          "in": "path",
          "name": "iid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncResult"
              }
            }
          },
          "description": "Connection report"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request or endpoint, egress rejection, unreachable endpoint, or generic probe unsupported on Workers"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Environment or application not found"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Test the integration credentials",
      "tags": [
        "integrations"
      ]
    }
  }
}
