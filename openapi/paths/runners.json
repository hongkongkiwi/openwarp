{
 "/api/orgs/{oid}/runners": {
  "get":{"summary":"List workspace runners","description":"Requires org:admin. Returns pubkey, not public_key, and never the runner token.","tags":["runners"],"parameters":[{"in":"path","name":"oid","required":true,"schema":{"type":"string"}}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Runners","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Runner"}}}}},"400":{"description":"Storage failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Not an administrator","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},
  "post":{"summary":"Register a runner","description":"Requires org:admin, a nonempty trimmed name and a base64 X25519 public key decoding to exactly 32 bytes. Token is shown once.","tags":["runners"],"parameters":[{"in":"path","name":"oid","required":true,"schema":{"type":"string"}}],"security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["name","public_key"],"properties":{"name":{"type":"string"},"public_key":{"type":"string"}}}}}},"responses":{"200":{"description":"Runner and one-time token","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RunnerCreated"}}}},"400":{"description":"Invalid name, key or storage failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Not an administrator","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}
 },
 "/api/orgs/{oid}/runners/{rid}":{"delete":{"summary":"Delete a runner","description":"Requires org:admin. Refuses deletion while any delegated environment references the runner.","tags":["runners"],"parameters":[{"in":"path","name":"oid","required":true,"schema":{"type":"string"}},{"in":"path","name":"rid","required":true,"schema":{"type":"string"}}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Deleted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Deleted"}}}},"400":{"description":"Storage failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Not an administrator","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Runner not found in workspace","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Runner owns a delegated environment","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},
 "/api/runner/jobs":{"get":{"summary":"Claim runnable sync jobs","description":"Requires the runner's own token, not an account token. Claims up to ten jobs; claims older than 600 seconds may be reclaimed. Locked workspaces and applications are excluded. Payloads omit sealed secrets.","tags":["runners"],"parameters":[],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Claimed jobs","content":{"application/json":{"schema":{"type":"object","properties":{"jobs":{"type":"array","items":{"$ref":"#/components/schemas/RunnerJob"}}}}}}},"400":{"description":"Storage failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid runner token","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Workspace halted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},
 "/api/runner/jobs/{jid}/result":{"post":{"summary":"Report a claimed job result","description":"Requires the owning runner token and current claim fencing token. Superseded or non-claimed jobs return 409. A successful sync with nonempty managed entries replaces tracked remote names.","tags":["runners"],"parameters":[{"in":"path","name":"jid","required":true,"schema":{"type":"string"}}],"security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RunnerJobResult"}}}},"responses":{"200":{"description":"Recorded status","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":"string","enum":["done","failed"]}}}}}},"400":{"description":"Storage failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Invalid runner token","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Workspace or application halted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Job or environment not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Claim is no longer current","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}}
}
