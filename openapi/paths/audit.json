{
  "/api/orgs/{oid}/audit": {
    "get": {
      "description": "Requires organisation membership. Returns newest events first. During emergency lockdown detail is empty and chain hashes are omitted.",
      "parameters": [
        {
          "in": "path",
          "name": "oid",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Parsed as integer and clamped to 1-1000; invalid values use 500.",
          "in": "query",
          "name": "limit",
          "schema": {
            "default": 500,
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          }
        },
        {
          "description": "Parsed as integer and clamped to at least zero; invalid values use zero.",
          "in": "query",
          "name": "offset",
          "schema": {
            "default": 0,
            "minimum": 0,
            "type": "integer"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/ChainedAuditEntry"
                },
                "type": "array"
              }
            }
          },
          "description": "Audit rows"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request or database error"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "List recent audit events",
      "tags": [
        "audit"
      ]
    }
  },
  "/api/orgs/{oid}/audit/verify": {
    "get": {
      "description": "Checks chained rows in sequence order and compares the stored head. Reports legacy unchained rows separately.",
      "parameters": [
        {
          "in": "path",
          "name": "oid",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuditVerification"
              }
            }
          },
          "description": "Success"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Invalid request or database error"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Missing or invalid credential"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Error"
              }
            }
          },
          "description": "Not permitted"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Verify the audit hash chain (org:admin)",
      "tags": [
        "audit"
      ]
    }
  },
