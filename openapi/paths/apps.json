{
  "/api/orgs/{oid}/apps": {
    "get": {"summary":"List applications","description":"Requires organisation membership. Automation does not see emergency-locked applications. Environment-scoped tokens cannot use this route.","tags":["apps"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"oid","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Applications","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AppDetails"}}}}},"400":{"description":"Database error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Membership or credential scope denied","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},
    "post": {"summary":"Create an application with Development, Staging and Production","description":"Requires organisation membership and secrets:write. Environment-scoped tokens cannot use this route.","tags":["apps"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"oid","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NameRequest"}}}},"responses":{"200":{"description":"Created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Id"}}}},"400":{"description":"Creation failed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Permission or scope denied","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}
  },
  "/api/apps/{aid}": {
    "patch":{"summary":"Rename an application","description":"Requires org:admin permission (owner/admin or a custom role granting it). Name is trimmed and must be nonempty; readme is ignored. Environment-scoped tokens cannot use this route.","tags":["apps"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"aid","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NameRequest"}}}},"responses":{"200":{"description":"Renamed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Ok"}}}},"400":{"description":"Missing application, empty name or database error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Permission or scope denied","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},
    "delete":{"summary":"Delete an application and its environments","description":"Requires org:admin permission. Revoke unresolved dynamic leases first. Environment-scoped tokens cannot use this route.","tags":["apps"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"aid","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Deleted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Ok"}}}},"400":{"description":"Missing application or database error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Permission or scope denied","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Application changed or has unresolved leases","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}
  },
  "/api/apps/{aid}/settings": {
    "get":{"summary":"Read application reuse-check settings","description":"Requires organisation membership; environment-scoped tokens cannot use this route.","tags":["apps"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"aid","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Settings","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AppSettings"}}}},"400":{"description":"Missing application or database error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Membership or scope denied","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},
    "put":{"summary":"Set application reuse-check settings","description":"Requires org:admin permission; environment-scoped tokens cannot use this route.","tags":["apps"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"aid","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AppSettings"}}}},"responses":{"200":{"description":"Saved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Ok"}}}},"400":{"description":"Missing application, invalid reuse_check or database error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Permission or scope denied","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}
  },
  "/api/apps/{aid}/emergency": {
    "get":{"summary":"Read application emergency lockdown state","description":"Requires an ow_session browser cookie backed by an account session and organisation membership. Authorization headers are rejected; bearerAuth is not accepted by this handler.","tags":["apps"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"aid","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Effective, direct and workspace lock state","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AppEmergencyState"}}}},"400":{"description":"Database error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Browser session required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Not a browser session or organisation member","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Application not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},
    "put":{"summary":"Change application emergency lockdown","description":"Requires an actual workspace owner using an ow_session browser cookie. Authorization headers are rejected; bearerAuth is not accepted. Unlocking a project cannot bypass a workspace lock. Locking revokes non-owner sessions and OAuth credentials.","tags":["apps"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"aid","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AppEmergencyRequest"}}}},"responses":{"200":{"description":"Lock state","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AppEmergencyState"}}}},"400":{"description":"Database error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Browser session required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Owner browser session required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Application not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}
  }
}
