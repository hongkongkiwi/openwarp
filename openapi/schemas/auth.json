{
  "Account": {
    "allOf": [
      {
        "$ref": "#/components/schemas/Me"
      },
      {
        "properties": {
          "env_scope": {
            "description": "Environment restriction of the presented API credential, or an empty string.",
            "type": "string"
          }
        },
        "type": "object"
      }
    ]
  },
  "AccountAuth": {
    "properties": {
      "auth_version": {
        "type": "integer"
      },
      "kdf_algo": {
        "type": "string"
      },
      "kdf_iterations": {
        "type": "integer"
      },
      "kdf_salt": {
        "type": "string"
      },
      "public_key": {
        "type": "string"
      },
      "wrapped_privkey": {
        "type": "string"
      }
    },
    "type": "object"
  },
  "AccountDeleted": {
    "properties": {
      "deleted": {
        "type": "boolean"
      },
      "revoked_api_keys": {
        "type": "integer"
      },
      "revoked_oauth_sessions": {
        "type": "integer"
      }
    },
    "type": "object"
  },
  "MfaEmailSent": {
    "properties": {
      "sent": {
        "type": "boolean"
      }
    },
    "type": "object"
  },
  "MfaEmailStatus": {
    "properties": {
      "email": {
        "type": "boolean"
      },
      "recovery_codes": {
        "description": "Only included on enrollment verification; null if recovery codes already exist.",
        "items": {
          "type": "string"
        },
        "type": [
          "array",
          "null"
        ]
      }
    },
    "type": "object"
  },
  "MfaOptions": {
    "properties": {
      "email_available": {
        "type": "boolean"
      },
      "methods": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "recovery_codes": {
        "type": "integer"
      }
    },
    "type": "object"
  },
  "MfaStatus": {
    "properties": {
      "email": {
        "type": "boolean"
      },
      "email_available": {
        "type": "boolean"
      },
      "methods": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "passkeys": {
        "items": {
          "properties": {
            "created_at": {
              "type": "integer"
            },
            "id": {
              "type": "string"
            },
            "last_used_at": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "type": "array"
      },
      "recovery_codes": {
        "type": "integer"
      },
      "required": {
        "type": "boolean"
      },
      "totp": {
        "type": "boolean"
      }
    },
    "type": "object"
  },
  "MfaTokenRequest": {
    "properties": {
      "mfa_token": {
        "description": "Challenge token returned by a login that requires a second factor.",
        "type": "string"
      }
    },
    "required": [
      "mfa_token"
    ],
    "type": "object"
  },
  "PasskeyCreated": {
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "recovery_codes": {
        "items": {
          "type": "string"
        },
        "type": [
          "array",
          "null"
        ]
      }
    },
    "type": "object"
  },
  "PasskeyLoginRequest": {
    "properties": {
      "credential": {
        "additionalProperties": true,
        "description": "WebAuthn PublicKeyCredential JSON.",
        "type": "object"
      },
      "mfa_token": {
        "type": "string"
      }
    },
    "required": [
      "mfa_token",
      "credential"
    ],
    "type": "object"
  },
  "PasskeyLoginResult": {
    "properties": {
      "token": {
        "type": "string"
      },
      "user_id": {
        "type": "string"
      }
    },
    "type": "object"
  },
  "PasskeyLoginStart": {
    "properties": {
      "options": {
        "additionalProperties": true,
        "description": "WebAuthn PublicKeyCredentialRequestOptions JSON.",
        "type": "object"
      }
    },
    "type": "object"
  },
  "PasskeyRegistration": {
    "properties": {
      "options": {
        "additionalProperties": true,
        "description": "WebAuthn CreationChallengeResponse serialized by webauthn-rs, containing publicKey creation options.",
        "type": "object"
      },
      "state_id": {
        "type": "string"
      }
    },
    "type": "object"
  },
  "RecoveryCodes": {
    "properties": {
      "recovery_codes": {
        "items": {
          "type": "string"
        },
        "type": "array"
      }
    },
    "type": "object"
  },
  "StepUpChallenge": {
    "description": "Without TOTP, two_factor returns only not_required=true and methods=[]. Otherwise returns challenge, risk, methods and email_sent.",
    "properties": {
      "challenge": {
        "type": "string"
      },
      "email_sent": {
        "type": "boolean"
      },
      "methods": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "not_required": {
        "type": "boolean"
      },
      "risk": {
        "type": "string"
      }
    },
    "type": "object"
  },
  "StepUpGrant": {
    "properties": {
      "expires_in": {
        "const": 300,
        "type": "integer"
      },
      "risk": {
        "type": "string"
      },
      "token": {
        "type": "string"
      }
    },
    "type": "object"
  },
  "TotpSetup": {
    "properties": {
      "note": {
        "type": "string"
      },
      "otpauth_url": {
        "type": "string"
      },
      "recovery_codes": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "secret": {
        "type": "string"
      }
    },
    "type": "object"
  },
  "TotpStatus": {
    "properties": {
      "totp": {
        "type": "boolean"
      }
    },
    "type": "object"
  },
  "TotpVerified": {
    "properties": {
      "enabled": {
        "type": "boolean"
      }
    },
    "type": "object"
  }
}
