{
  "E2eDeployResult": {
    "properties": {
      "deployed": {
        "type": "integer"
      }
    },
    "type": "object"
  },
  "E2eMeta": {
    "properties": {
      "mode": {
        "type": "string"
      },
      "rekey_required": {
        "type": "boolean"
      },
      "runner": {
        "properties": {
          "id": {
            "type": "string"
          },
          "public_key": {
            "type": "string"
          }
        },
        "type": [
          "object",
          "null"
        ]
      }
    },
    "type": "object"
  },
  "E2eRekeyRequest": {
    "properties": {
      "grants": {
        "items": {
          "properties": {
            "user_id": {
              "type": "string"
            },
            "wrapped_key": {
              "type": "string"
            }
          },
          "required": [
            "user_id",
            "wrapped_key"
          ],
          "type": "object"
        },
        "minItems": 1,
        "type": "array"
      },
      "remove_user": {
        "type": "string"
      },
      "runner_wrapped_key": {
        "type": "string"
      },
      "secrets": {
        "items": {
          "allOf": [
            {
              "$ref": "#/components/schemas/E2eSecretInput"
            },
            {
              "required": [
                "key_hash",
                "key_enc",
                "value_enc",
                "path_enc"
              ]
            }
          ]
        },
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "secrets",
      "grants"
    ],
    "type": "object"
  },
  "E2eRekeyResult": {
    "properties": {
      "grants": {
        "type": "integer"
      },
      "rekeyed": {
        "type": "integer"
      }
    },
    "type": "object"
  },
  "E2eSecretInput": {
    "properties": {
      "key_enc": {
        "type": "string"
      },
      "key_hash": {
        "type": "string"
      },
      "path": {
        "default": "/",
        "description": "Legacy plaintext path, used only when path_enc is empty.",
        "type": "string"
      },
      "path_enc": {
        "type": "string"
      },
      "value_enc": {
        "type": "string"
      }
    },
    "type": "object"
  },
  "E2eSecretResult": {
    "properties": {
      "secrets": {
        "items": {
          "allOf": [
            {
              "$ref": "#/components/schemas/E2eSecretInput"
            },
            {
              "properties": {
                "id": {
                  "type": "string"
                },
                "updated_at": {
                  "type": "integer"
                },
                "version": {
                  "type": "integer"
                }
              },
              "type": "object"
            }
          ]
        },
        "type": "array"
      },
      "wrapped_key": {
        "type": "string"
      }
    },
    "type": "object"
  },
  "E2eSecretWrite": {
    "properties": {
      "secrets": {
        "items": {
          "$ref": "#/components/schemas/E2eSecretInput"
        },
        "type": "array"
      }
    },
    "type": "object"
  },
  "SecretDeployRequest": {
    "properties": {
      "secrets": {
        "items": {
          "$ref": "#/components/schemas/SecretWriteInput"
        },
        "type": "array"
      },
      "text": {
        "description": "Parsed as dotenv only when secrets is empty.",
        "type": "string"
      }
    },
    "type": "object"
  },
  "SecretDeployResult": {
    "allOf": [
      {
        "$ref": "#/components/schemas/DeployResult"
      },
      {
        "properties": {
          "scan_findings": {
            "items": {
              "$ref": "#/components/schemas/SecretScanFinding"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    ]
  },
  "SecretDestroyed": {
    "properties": {
      "destroyed": {
        "type": "boolean"
      }
    },
    "type": "object"
  },
  "SecretExport": {
    "allOf": [
      {
        "$ref": "#/components/schemas/ExportResult"
      },
      {
        "properties": {
          "omitted_sealed": {
            "type": "integer"
          }
        },
        "type": "object"
      }
    ]
  },
  "SecretOverride": {
    "properties": {
      "key": {
        "type": "string"
      },
      "value": {
        "type": "string"
      }
    },
    "type": "object"
  },
  "SecretOverrideDeleted": {
    "properties": {
      "deleted": {
        "type": "boolean"
      }
    },
    "type": "object"
  },
  "SecretPage": {
    "allOf": [
      {
        "$ref": "#/components/schemas/SecretsResult"
      },
      {
        "properties": {
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        },
        "type": "object"
      }
    ]
  },
  "SecretRestorePoint": {
    "allOf": [
      {
        "$ref": "#/components/schemas/RestorePointResult"
      },
      {
        "properties": {
          "removed": {
            "type": "integer"
          }
        },
        "type": "object"
      }
    ]
  },
  "SecretReuseRequest": {
    "properties": {
      "exclude": {
        "description": "Secret IDs to exclude.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "secrets": {
        "items": {
          "$ref": "#/components/schemas/SecretWriteInput"
        },
        "type": "array"
      }
    },
    "type": "object"
  },
  "SecretReuseResult": {
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "matches": {
        "items": {
          "properties": {
            "index": {
              "type": "integer"
            },
            "items": {
              "items": {
                "properties": {
                  "app_id": {
                    "type": "string"
                  },
                  "app_name": {
                    "type": "string"
                  },
                  "env_id": {
                    "type": "string"
                  },
                  "env_name": {
                    "type": "string"
                  },
                  "key": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "secret_id": {
                    "type": "string"
                  },
                  "updated_at": {
                    "type": "integer"
                  }
                },
                "type": "object"
              },
              "type": "array"
            },
            "key": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "type": "array"
      }
    },
    "type": "object"
  },
  "SecretRotationResult": {
    "allOf": [
      {
        "$ref": "#/components/schemas/RotateResult"
      },
      {
        "properties": {
          "rotation_hook_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "sync_errors": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    ]
  },
  "SecretScan": {
    "properties": {
      "findings": {
        "items": {
          "$ref": "#/components/schemas/SecretScanFinding"
        },
        "type": "array"
      }
    },
    "type": "object"
  },
  "SecretScanFinding": {
    "properties": {
      "key": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "rules": {
        "items": {
          "type": "string"
        },
        "type": "array"
      }
    },
    "type": "object"
  },
  "SecretTags": {
    "properties": {
      "tags": {
        "items": {
          "properties": {
            "count": {
              "type": "integer"
            },
            "tag": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "type": "array"
      }
    },
    "type": "object"
  },
  "SecretWriteInput": {
    "properties": {
      "comment": {
        "type": "string"
      },
      "expected_version": {
        "description": "0 means create-only; n requires current version n. Mismatch returns 409.",
        "type": [
          "integer",
          "null"
        ]
      },
      "key": {
        "pattern": "^[A-Za-z0-9_.-]{1,128}$",
        "type": "string"
      },
      "path": {
        "default": "/",
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "tags": {
        "type": "string"
      },
      "type": {
        "enum": [
          "",
          "secret",
          "sealed",
          "ssh_key",
          "config"
        ],
        "type": "string"
      },
      "value": {
        "type": "string"
      }
    },
    "required": [
      "key",
      "value"
    ],
    "type": "object"
  }
}
